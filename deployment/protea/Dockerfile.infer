# Protea inference engine: vLLM OpenAI-compatible server with an optional LoRA adapter mount.
# Build:  docker build -f deployment/protea/Dockerfile.infer -t ghcr.io/malcolmgov/protea-infer:latest .
# Run:    docker run --gpus all -p 8000:8000 -e PROTEA_INFERENCE_TOKEN=... -e HF_TOKEN=... \
#           -v /srv/adapters:/adapters:ro -v /srv/hf-cache:/root/.cache/huggingface \
#           ghcr.io/malcolmgov/protea-infer:latest
FROM vllm/vllm-openai:v0.11.0

ENV PYTHONUNBUFFERED=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    PROTEA_INFERENCE_CONFIG=/app/configs/inference/vllm-qwen3-8b.yaml

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY protea ./protea
COPY configs ./configs
COPY deployment/protea/entrypoint-infer.sh /usr/local/bin/entrypoint-infer.sh
RUN pip install --no-cache-dir --no-deps . && chmod +x /usr/local/bin/entrypoint-infer.sh

# Adapters are mounted, never baked in; weights come from the HF cache volume.
VOLUME ["/adapters", "/root/.cache/huggingface"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=5 \
  CMD curl -fsS http://localhost:8000/health || exit 1
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/entrypoint-infer.sh"]
