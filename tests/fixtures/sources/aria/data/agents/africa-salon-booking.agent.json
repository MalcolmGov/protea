{
 "format": "zara.agent-package/v1",
 "manifest": {
  "id": "africa-salon-booking",
  "name": "Salon Booking",
  "version": "1.0.0",
  "category": "vertical",
  "tier": "standard",
  "market": "africa",
  "compliance": [
   "popia"
  ],
  "summary": "Books salon appointments over WhatsApp for MyInstantAI clients.",
  "channels": [
   "whatsapp",
   "web"
  ],
  "languages": [
   "en",
   "zu"
  ],
  "model": {
   "primary": "claude-sonnet",
   "fallback": "gpt-4o-mini",
   "temperature": 0.3,
   "max_output_tokens": 600
  },
  "handoff": {
   "enabled": true,
   "triggers": [
    "complaint",
    "explicit_request"
   ]
  }
 },
 "system_prompt": "You are the booking assistant for {business_name}. Capture the service, day, time, name and phone number. Never guarantee a slot.",
 "knowledge": "Services: cut R120, colour R450. Open Mon-Sat 08:00-18:00. Call us on 082 555 1234.",
 "tools": [
  {
   "name": "list_services",
   "description": "List services with prices.",
   "parameters": {
    "type": "object",
    "properties": {
     "category": {
      "type": "string"
     }
    }
   },
   "side_effects": "read-only"
  },
  {
   "name": "check_availability",
   "description": "Check open slots.",
   "parameters": {
    "type": "object",
    "properties": {
     "day": {
      "type": "string"
     }
    },
    "required": [
     "day"
    ]
   },
   "side_effects": "read-only"
  },
  {
   "name": "book_appointment",
   "description": "Book a slot.",
   "parameters": {
    "type": "object",
    "properties": {
     "day": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "day",
     "name"
    ]
   },
   "side_effects": "write"
  },
  {
   "name": "handoff_to_human",
   "description": "Hand off.",
   "parameters": {
    "type": "object",
    "properties": {}
   },
   "side_effects": "write"
  }
 ],
 "guardrails": "Never request passwords, PINs or OTPs. Escalate complaints to a human. Contact our desk on 071 234 5678 or desk@salon.example.com for disputes.",
 "evals": [
  {
   "id": "list",
   "channel": "whatsapp",
   "lang": "en",
   "input": "What do you offer?",
   "expect": {
    "tool": "list_services",
    "says_any": [
     "cut",
     "colour"
    ]
   }
  },
  {
   "id": "no-invent",
   "channel": "web",
   "lang": "en",
   "input": "Put me down for 3pm tomorrow.",
   "expect": {
    "tool_none": [
     "book_appointment"
    ],
    "says_any": [
     "check",
     "available"
    ]
   }
  },
  {
   "id": "bad-tool",
   "channel": "web",
   "lang": "en",
   "input": "x",
   "expect": {
    "tool": "does_not_exist"
   }
  },
  {
   "id": "zulu",
   "channel": "whatsapp",
   "lang": "zu",
   "input": "Sawubona, ngingabhuka nini?",
   "expect": {
    "tool": "check_availability",
    "lang": "zu"
   }
  },
  {
   "id": "klingon",
   "channel": "web",
   "lang": "tlh",
   "input": "nuqneH",
   "expect": {
    "no_tool": true
   }
  }
 ]
}